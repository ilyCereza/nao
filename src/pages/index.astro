<script>

  console.log("El script se está ejecutando en el cliente");
    import gsap from 'gsap';

    function initAnimations() {

        const tl = gsap.timeline();

        tl.from('.stick', {
          delay: 1,
          scaleY: 0,
          opacity: 0,
          duration: 1.2,
          ease: 'back.out(1.7)',
          transformOrigin: 'center center',
          stagger: 0.5
        });
        
        tl.from('.leave', {
          scale: 0,
          opacity: 0,
          duration: 1.2,
          ease: 'back.out(1.7)',
          transformOrigin: 'center center',
          stagger: 0.5
        });

        tl.from('.flower', {
          scale: 0,
          opacity: 0,
          duration: 1.2,
          ease: 'back.out(1.7)',
          transformOrigin: 'center center',
          stagger: 0.5
        });

        

        tl.from('#wrap', {
          opacity: 0,
          duration: 1.2,
          ease: 'back.out(1.7)', // 'back.out' hace que sobrepase ligeramente el 100% y regrese (efecto pop)
          transformOrigin: 'center center',
          stagger: 0.5
        });

        tl.from('#wrap2', {
          opacity: 0,
          duration: 1.2,
          ease: 'back.out(1.7)', // 'back.out' hace que sobrepase ligeramente el 100% y regrese (efecto pop)
          transformOrigin: 'center center',
          stagger: 0.5
        }, "<");
    }

    const btn = document.getElementById("btn");
    if(btn){
      btn.addEventListener("click", initAnimations);
    }

</script>

